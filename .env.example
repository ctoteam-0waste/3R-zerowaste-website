# Copy to .env.local for local testing (never commit real values).
# Admin panel at /admin
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=any-long-random-string
# Leave empty locally: the admin then saves to the files on your computer.
# On Hostinger set a fine-grained token with Contents: Read and write on the repo below.
GITHUB_TOKEN=
GITHUB_REPO=ctoteam-0waste/3R-zerowaste-website
# Optional: Google Search Console / Bing "HTML tag" verification codes (just the content="…" value)
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
# Optional: override the public site address (defaults to https://0waste.co.in)
# NEXT_PUBLIC_SITE_URL=https://0waste.co.in
# AI blog writer in /admin (Write with AI → Get ideas / Write full blog). Get a key at console.anthropic.com.
ANTHROPIC_API_KEY=

# Newsletter subscribers, blog reactions and views are saved on the "site-data" branch of the
# GitHub repo above (no outside service). The subscriber list is encrypted with this key —
# set it once to a long random string and never change it (falls back to ADMIN_SESSION_SECRET).
DATA_ENCRYPTION_KEY=
